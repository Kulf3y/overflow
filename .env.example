# Overflow Provider Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Provider: mock, openai, mistral, ollama, openai_compatible
OVERFLOW_PROVIDER=mock

# Your API key (leave empty for mock or ollama)
OVERFLOW_PROVIDER_API_KEY=

# Base URL (optional, auto-detected for known providers)
# OVERFLOW_PROVIDER_BASE_URL=

# Model name (optional, has defaults for known providers)
# OVERFLOW_PROVIDER_MODEL=
